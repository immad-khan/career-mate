# Job Crawler Configuration
# Copy this file to .env and modify as needed

# Crawler Settings
HEADLESS=true
SLOW_MO=100
TIMEOUT=30000
MAX_RETRIES=3

# Search Defaults
DEFAULT_LOCATION=Pakistan
DEFAULT_MAX_PAGES=3
DEFAULT_SOURCES=indeed,rozee

# Output Settings
OUTPUT_FORMAT=json
SAVE_DIRECTORY=./data
LOG_DIRECTORY=./logs

# Platform Settings
INDEED_ENABLED=true
ROZEE_ENABLED=true
LINKEDIN_ENABLED=false

# Rate Limiting (milliseconds)
INDEED_DELAY=3000
ROZEE_DELAY=4000
LINKEDIN_DELAY=8000

# Optional: Proxy Settings (if needed)
# PROXY_HOST=
# PROXY_PORT=
# PROXY_USER=
# PROXY_PASS=

# Optional: User Agent Override
# USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36